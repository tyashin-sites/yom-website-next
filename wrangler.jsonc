{
  // Worker name = site-<project-slug>. /adopt registers `site-yom-website`;
  // keep this identical to the workerScriptName /adopt returns.
  "name": "site-yom-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    // Shared platform namespace (SHARED_NEXT_INC_CACHE_KV_ID in the addendum).
    { "binding": "NEXT_INC_CACHE_KV", "id": "426d3a7563b14b9ab194d8495ae1c7ef" }
  ],
  // ISR revalidation queue (open-next.config.ts `queue: doQueue`). Without it
  // stale pages are never regenerated — tyashin-platform CLAUDE.md §12c-bis.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "site-yom-website" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    "TYASHIN_API_URL": "https://website-api.tyashin.com",
    // Indexing switch. "false" for the production build (going live
    // 2026-10-23). Set "true" for a preview build — prerendered pages bake
    // this at BUILD time, so export it in the build env too and rebuild.
    "ROBOTS_NOINDEX": "false",
    // Canonical origin (decided 2026-10-23). Must also be exported at build time.
    "SITE_URL": "https://yom.aapastech.com"
  }
}
